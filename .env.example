# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cf_erp
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cf_erp
DB_SCHEMA=public
DB_SSL=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECTION_TIMEOUT=10000
REDIS_MAX_RETRIES=3

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cf-erp
JWT_AUDIENCE=cf-erp-api

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_TIMEOUT=10000
RABBITMQ_HEARTBEAT=60

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cf-erp
KAFKA_GROUP_ID=cf-erp-group
KAFKA_SSL=false
KAFKA_SASL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@cf-erp.com
EMAIL_FROM_NAME=CF-ERP
EMAIL_TEMPLATES_DIR=./templates/email

# SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=

# Push Notifications
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# File Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_CDN_URL=
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# Monitoring
MONITORING_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=CF-ERP API
SWAGGER_DESCRIPTION=Clearing & Forwarding ERP API Documentation
SWAGGER_VERSION=1.0.0

# Feature Flags
FF_CUSTOMER_PORTAL=false
FF_MOBILE_APP=false
FF_AI_ASSISTANT=false
FF_ADVANCED_ANALYTICS=false
FF_BLOCKCHAIN_TRACKING=false

# Integrations
CUSTOMS_INTEGRATION_ENABLED=false
CUSTOMS_API_URL=
CUSTOMS_API_KEY=
SHIPPING_LINES_INTEGRATION_ENABLED=false
SHIPPING_LINES_API_URL=
SHIPPING_LINES_API_KEY=
PORTS_INTEGRATION_ENABLED=false
PORTS_API_URL=
PORTS_API_KEY=
BANKS_INTEGRATION_ENABLED=false
BANKS_API_URL=
BANKS_API_KEY=
ERP_INTEGRATION_ENABLED=false
ERP_API_URL=
ERP_API_KEY=

# Service Ports
AUTH_SERVICE_PORT=3001
CUSTOMER_SERVICE_PORT=3002
QUOTATION_SERVICE_PORT=3003
JOB_SERVICE_PORT=3004
BOOKING_SERVICE_PORT=3005
CUSTOMS_SERVICE_PORT=3006
DOCUMENT_SERVICE_PORT=3007
TRACKING_SERVICE_PORT=3008
WAREHOUSE_SERVICE_PORT=3009
TRANSPORT_SERVICE_PORT=3010
CONTAINER_SERVICE_PORT=3011
DEMURRAGE_SERVICE_PORT=3012
FINANCE_SERVICE_PORT=3013
INVOICING_SERVICE_PORT=3014
DUTY_SERVICE_PORT=3015
AR_AP_SERVICE_PORT=3016
AGENT_SERVICE_PORT=3017
PORTAL_SERVICE_PORT=3018
WORKFLOW_SERVICE_PORT=3019
HR_SERVICE_PORT=3020
REPORTS_SERVICE_PORT=3021
AUDIT_SERVICE_PORT=3022
BRANCH_SERVICE_PORT=3023
CONFIG_SERVICE_PORT=3024
CURRENCY_SERVICE_PORT=3025
INTEGRATION_SERVICE_PORT=3026
NOTIFICATION_SERVICE_PORT=3027
ADMIN_SERVICE_PORT=3028
DASHBOARD_SERVICE_PORT=3029