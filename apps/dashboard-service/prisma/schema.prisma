generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dashboard", "public"]
}

model Dashboard {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            DashboardType
  category        String?
  layout          Json
  widgets         Json
  filters         Json?
  isPublic        Boolean          @default(false)
  isDefault       Boolean          @default(false)
  refreshInterval Int              @default(300)
  theme           String           @default("light")
  layoutType      LayoutType       @default(GRID)
  columns         Int              @default(12)
  rowHeight       Int              @default(50)
  margin          Int              @default(10)
  padding         Int              @default(10)
  backgroundColor String?
  backgroundImage String?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  widgets         DashboardWidget[]
  favorites       DashboardFavorite[]
  shares          DashboardShare[]

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([isPublic])
  @@index([isDefault])
  @@index([createdBy])
}

model DashboardWidget {
  id              String   @id @default(cuid())
  dashboardId     String
  widgetId        String
  type            WidgetType
  title           String
  config          Json
  position        Json
  size            Json
  dataSource      String?
  query           Json?
  refreshInterval Int?
  isVisible       Boolean  @default(true)
  order           Int      @default(0)
  locked          Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dashboard       Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@schema("dashboard")
  @@unique([dashboardId, widgetId])
  @@index([dashboardId])
  @@index([widgetId])
  @@index([type])
}

model DashboardFavorite {
  id          String   @id @default(cuid())
  dashboardId String
  userId      String
  tenantId    String
  createdAt   DateTime @default(now())

  @@schema("dashboard")
  @@unique([dashboardId, userId])
  @@index([dashboardId])
  @@index([userId])
}

model DashboardShare {
  id              String           @id @default(cuid())
  dashboardId     String
  sharedWithId    String
  sharedWithType  ShareWithType
  permission      SharePermission
  sharedBy        String
  sharedAt        DateTime         @default(now())
  expiresAt       DateTime?
  message         String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  dashboard       Dashboard        @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@schema("dashboard")
  @@unique([dashboardId, sharedWithId, sharedWithType])
  @@index([dashboardId])
  @@index([sharedWithId])
  @@index([sharedWithType])
}

model Widget {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            WidgetType
  category        String
  icon            String?
  defaultConfig   Json
  defaultSize     Json
  defaultPosition Json?
  minSize         Json?
  maxSize         Json?
  supportedDataSources String[]
  requiredConfig  Json?
  defaultRefreshInterval Int?
  isActive        Boolean          @default(true)
  isSystem        Boolean          @default(false)
  version         String           @default("1.0.0")
  documentation   String?
  tags            String[]         @default([])
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([isSystem])
}

model KPI {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  formula         String
  unit            String
  target          Decimal?         @db.Decimal(18, 2)
  warningThreshold Decimal?        @db.Decimal(18, 2)
  criticalThreshold Decimal?       @db.Decimal(18, 2)
  trendDirection  TrendDirection?
  format          KPIFormat        @default(NUMBER)
  decimalPlaces   Int              @default(2)
  color           String?
  category        String?
  isActive        Boolean          @default(true)
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  values          KPIValue[]

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

model KPIValue {
  id              String           @id @default(cuid())
  kpiId           String
  value           Decimal          @db.Decimal(18, 4)
  period          String
  periodStart     DateTime
  periodEnd       DateTime
  dimensions      Json?
  computedAt      DateTime         @default(now())
  tenantId        String
  createdAt       DateTime         @default(now())

  kpi             KPI              @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@schema("dashboard")
  @@unique([kpiId, period, periodStart])
  @@index([kpiId])
  @@index([period])
  @@index([periodStart])
}

model Alert {
  id              String           @id @default(cuid())
  code            String
  name            String
  kpiId           String?
  condition       Json
  severity        AlertSeverity
  channels        NotificationChannel[]
  message         String?
  isActive        Boolean          @default(true)
  triggeredAt     DateTime?
  resolvedAt      DateTime?
  triggerCount    Int              @default(0)
  lastTriggeredAt DateTime?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([kpiId])
  @@index([isActive])
}

model View {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            ViewType
  config          Json
  filters         Json?
  sorting         Json?
  grouping        Json?
  pagination      Json?
  isPublic        Boolean          @default(false)
  isDefault       Boolean          @default(false)
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isPublic])
  @@index([isDefault])
}

model Layout {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            LayoutType
  config          Json
  breakpoints     Json?
  containers      Json
  isActive        Boolean          @default(true)
  isSystem        Boolean          @default(false)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([isSystem])
}

model Report {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            ReportType
  template        Json
  parameters      Json?
  schedule        ReportSchedule?
  outputFormat    OutputFormat[]   @default(["PDF"])
  isPublic        Boolean          @default(false)
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  executions      ReportExecution[]

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isPublic])
}

model ReportExecution {
  id              String           @id @default(cuid())
  reportId        String
  status          ExecutionStatus  @default(PENDING)
  parameters      Json?
  outputFormat    OutputFormat
  fileUrl         String?
  fileSize        BigInt?
  rowCount        Int?
  startedAt       DateTime
  completedAt     DateTime?
  errorMessage    String?
  errorStack      String?
  executedBy      String?
  scheduled       Boolean          @default(false)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  report          Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@schema("dashboard")
  @@index([reportId])
  @@index([status])
  @@index([executedBy])
  @@index([createdAt])
}

model DataSource {
  id              String           @id @default(cuid())
  code            String
  name            String
  type            DataSourceType
  description     String?
  config          Json
  credentials     Json?
  isActive        Boolean          @default(true)
  isDefault       Boolean          @default(false)
  testQuery       String?
  lastTestAt      DateTime?
  lastTestStatus  TestStatus?
  lastTestError   String?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  createdBy       String?
  updatedBy       String?

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([isDefault])
}

model Dataset {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  sourceType      DataSourceType
  sourceConfig    Json
  query           String?
  schema          Json?
  refreshPolicy   RefreshPolicy?
  lastRefreshedAt DateTime?
  nextRefreshAt   DateTime?
  rowCount        BigInt?
  sizeBytes       BigInt?
  status          DatasetStatus    @default(BUILDING)
  lastError       String?
  tags            String[]         @default([])
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  @@schema("dashboard")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@index([lastRefreshedAt])
}

model AnalyticsEvent {
  id              String           @id @default(cuid())
  eventType       String
  entityType      String
  entityId        String?
  userId          String?
  sessionId       String?
  properties      Json
  timestamp       DateTime         @default(now())
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())

  @@schema("dashboard")
  @@index([tenantId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

