model ChargeRate {
  id              String           @id @default(cuid())
  code            String
  name            String
  type            RateType
  chargeType      ChargeRateType
  location        String
  depotId         String?
  terminalId      String?
  carrierId       String?
  containerType   ContainerType?
  containerSize   ContainerSize?
  freeDays        Int
  dailyRate       Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  tierRates       Json?
  seasonalRates   Json?
  validFrom       DateTime
  validUntil      DateTime?
  isActive        Boolean          @default(true)
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("demurrage")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([chargeType])
  @@index([carrierId])
  @@index([containerType])
  @@index([containerSize])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

