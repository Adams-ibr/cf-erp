model DemurrageDispute {
  id              String           @id @default(cuid())
  demurrageChargeId String
  code            String
  type            DisputeType
  status          DisputeStatus    @default(OPEN)
  reason          String
  claimedAmount   Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  requestedBy     String
  assignedTo      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolution      DisputeResolution?
  resolutionAmount Decimal?        @db.Decimal(12, 2)
  evidence        String[]         @default([])
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  demurrageCharge DemurrageCharge  @relation(fields: [demurrageChargeId], references: [id], onDelete: Cascade)

  @@schema("demurrage")
  @@unique([tenantId, code])
  @@index([demurrageChargeId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@index([resolvedBy])
}

model DetentionDispute {
  id              String           @id @default(cuid())
  detentionChargeId String
  code            String
  type            DisputeType
  status          DisputeStatus    @default(OPEN)
  reason          String
  claimedAmount   Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  requestedBy     String
  assignedTo      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolution      DisputeResolution?
  resolutionAmount Decimal?        @db.Decimal(12, 2)
