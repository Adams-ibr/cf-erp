model Container {
  id              String   @id @default(cuid())
  code            String
  number          String   @unique
  tenantId        String
  isDeleted       Boolean  @default(false)

  @@schema("demurrage")
  @@unique([tenantId, code])
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([number])
}

model Customer {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("demurrage")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Carrier {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("demurrage")
  @@unique([tenantId, code])
  @@index([tenantId])
}

enum DemurrageType {
  IMPORT
  EXPORT
  TRANSIT
  REPOSITIONING
}

enum DetentionType {
  IMPORT
  EXPORT
  TRANSIT
  REPOSITIONING
}

enum StorageType {
  WAREHOUSE
  DEPOT
  TERMINAL
  CFS
  ICD
  BONDED_WAREHOUSE
}

enum ChargeStatus {
  PENDING
  CALCULATING
  CALCULATED
  INVOICED
  PARTIAL_PAID
  PAID
  OVERDUE
  DISPUTED
  WAIVED
  CANCELLED
  EXPIRED
}

enum ChargeRateType {
  DEMURRAGE
  DETENTION
  STORAGE
}

enum WaiverType {
  CARRIER_WAIVER
  CUSTOMER_WAIVER
  FORCE_MAJEURE
  CUSTOMS_HOLD
  DOCUMENT_DELAY
  EQUIPMENT_ISSUE
  WEATHER
  PORT_CONGESTION
  STRIKE
  HOLIDAY
  CUSTOMER_SERVICE
  NEGOTIATED
  OTHER
}

enum WaiverStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  REVOKED
}

enum DisputeType {
  RATE_DISPUTE
  DAYS_DISPUTE
  FREE_TIME_DISPUTE
  WAIVER_DISPUTE
  CALCULATION_ERROR
  DOCUMENTATION
  CONTRACT_TERMS
  FORCE_MAJEURE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  NEGOTIATING
  RESOLVED
  ESCALATED
  CLOSED
  WITHDRAWN
}

enum DisputeResolution {
  FULL_WAIVER
  PARTIAL_WAIVER
  RATE_ADJUSTMENT
  DAYS_ADJUSTMENT
  ORIGINAL_UPHELD
  SPLIT_DIFFERENCE
  SETTLED
}

enum ContainerType {
  DRY_20FT
  DRY_40FT
  DRY_40FT_HC
  DRY_45FT_HC
  REEFER_20FT
  REEFER_40FT
  REEFER_40FT_HC
  OPEN_TOP_20FT
  OPEN_TOP_40FT
  FLAT_RACK_20FT
  FLAT_RACK_40FT
  TANK_20FT
  TANK_40FT
  SPECIAL
}

enum ContainerSize {
  SIZE_20FT
  SIZE_40FT
  SIZE_45FT
}