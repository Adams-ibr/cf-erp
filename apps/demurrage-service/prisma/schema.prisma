  id              String           @id @default(cuid())
  code            String
  containerId     String
  containerNumber String
  type            DetentionType
  status          ChargeStatus     @default(PENDING)
  location        String
  depotId         String?
  terminalId      String?
  vesselId        String?
  voyageId        String?
  bookingId       String?
  shipmentId      String?
  customerId      String
  carrierId       String?
  freeDays        Int
  usedDays        Int
  chargeableDays  Int
  dailyRate       Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  totalAmount     Decimal          @db.Decimal(12, 2)
  waivedAmount    Decimal          @default(0) @db.Decimal(12, 2)
  netAmount       Decimal          @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  invoiceId       String?
  invoiceDate     DateTime?
  paidDate        DateTime?
  paidAmount      Decimal          @default(0) @db.Decimal(12, 2)
  balanceAmount   Decimal          @db.Decimal(12, 2)
  notes           String?
  metadata        Json?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  createdBy       String?
