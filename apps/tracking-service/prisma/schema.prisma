generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["tracking", "public"]
}

model TrackingEvent {
  id              String              @id @default(cuid())
  code            String
  shipmentId      String
  type            TrackingEventType
  status          String
  location        String
  latitude        Decimal?            @db.Decimal(10, 8)
  longitude       Decimal?            @db.Decimal(11, 8)
  timestamp       DateTime
  source          String
  sourceReference String?
  vesselId        String?
  voyageId        String?
  containerId     String?
  equipmentId     String?
  temperature     Decimal?            @db.Decimal(5, 2)
  humidity        Decimal?            @db.Decimal(5, 2)
  details         String?
  metadata        Json?
  isMilestone     Boolean             @default(false)
  milestoneType   MilestoneType?
  tenantId        String
  branchId        String?
  createdAt       DateTime            @default(now())

  shipment        Shipment            @relation(fields: [shipmentId], references: [id])
  vessel          Vessel?             @relation(fields: [vesselId], references: [id])
  voyage          Voyage?             @relation(fields: [voyageId], references: [id])
  container       Container?          @relation(fields: [containerId], references: [id])

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([shipmentId])
  @@index([type])
  @@index([timestamp])
  @@index([vesselId])
  @@index([voyageId])
  @@index([containerId])
  @@index([isMilestone])
}

model Shipment {
  id              String       @id @default(cuid())
  code            String
  status          ShipmentStatus
  mode            ShipmentMode
  origin          String
  destination     String
  pol             String?
  pod             String?
  etd             DateTime?
  eta             DateTime?
  atd             DateTime?
  ata             DateTime?
  vesselId        String?
  voyageId        String?
  tenantId        String
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  trackingEvents  TrackingEvent[]

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@index([vesselId])
  @@index([voyageId])
}

model Vessel {
  id          String   @id @default(cuid())
  code        String
  name        String
  imo         String?
  mmsi        String?
  callSign    String?
  flag        String?
  type        VesselType
  tenantId    String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@unique([tenantId, imo])
  @@index([tenantId])
  @@index([imo])
}

model Voyage {
  id          String   @id @default(cuid())
  code        String
  name        String
  vesselId    String
  serviceCode String?
  pol         String
  pod         String
  etd         DateTime?
  eta         DateTime?
  atd         DateTime?
  ata         DateTime?
  status      VoyageStatus @default(SCHEDULED)
  tenantId    String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vessel      Vessel   @relation(fields: [vesselId], references: [id])

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([vesselId])
  @@index([status])
  @@index([etd, eta])
}

model Container {
  id          String           @id @default(cuid())
  code        String
  number      String
  type        ContainerType
  status      ContainerStatus
  tenantId    String
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([number])
  @@index([type])
  @@index([status])
}

model Notification {
  id              String              @id @default(cuid())
  code            String
  type            NotificationType
  channel         NotificationChannel
  priority        NotificationPriority
  title           String
  message         String
  recipientType   RecipientType
  recipientId     String?
  recipientEmail  String?
  recipientPhone  String?
  templateId      String?
  templateData    Json?
  status          NotificationStatus  @default(PENDING)
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  failedAt        DateTime?
  errorMessage    String?
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  scheduledAt     DateTime?
  trackingEventId String?
  shipmentId      String?
  tenantId        String
  branchId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([recipientType, recipientId])
  @@index([scheduledAt])
  @@index([sentAt])
}

model Alert {
  id              String          @id @default(cuid())
  code            String
  type            AlertType
  severity        AlertSeverity
  title           String
  message         String
  shipmentId      String?
  vesselId        String?
  voyageId        String?
  containerId     String?
  trackingEventId String?
  condition       Json
  isActive        Boolean         @default(true)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolvedAt      DateTime?
  resolvedBy      String?
  tenantId        String
  branchId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([isActive])
  @@index([shipmentId])
  @@index([vesselId])
  @@index([voyageId])
  @@index([containerId])
}

model Subscription {
  id              String              @id @default(cuid())
  code            String
  userId          String
  eventTypes      TrackingEventType[]
  channels        NotificationChannel[]
  shipmentIds     String[]
  vesselIds       String[]
  voyageIds       String[]
  containerIds    String[]
  filters         Json?
  isActive        Boolean             @default(true)
  tenantId        String
  branchId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([userId])
  @@index([isActive])
}

model NotificationTemplate {
  id              String              @id @default(cuid())
  code            String
  name            String
  type            NotificationType
  channel         NotificationChannel
  subject         String?
  content         String
  variables       String[]            @default([])
  isActive        Boolean             @default(true)
  tenantId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([channel])
  @@index([isActive])
}

model NotificationProvider {
  id              String              @id @default(cuid())
  code            String
  name            String
  type            ProviderType
  channel         NotificationChannel
  config          Json
  isActive        Boolean             @default(true)
  priority        Int                 @default(0)
  tenantId        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@schema("tracking")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([channel])
  @@index([isActive])
}

