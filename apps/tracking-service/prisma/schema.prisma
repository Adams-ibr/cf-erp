  VESSEL_ARRIVED
  DISCHARGED
  GATE_OUT
  DELIVERY_SCHEDULED
  DELIVERY_COMPLETED
  CUSTOMS_FILED
  CUSTOMS_CLEARED
  CUSTOMS_HOLD
  CUSTOMS_EXAM
  EXCEPTION
  DELAY
  DAMAGE
  TEMPERATURE_ALERT
  DOCUMENT_RECEIVED
  DOCUMENT_VERIFIED
  PAYMENT_RECEIVED
  MILESTONE_REACHED
