  TEMPERATURE_ALERT
  CUSTOMS_ALERT
  DOCUMENT_REQUIRED
  PAYMENT_REMINDER
  DELIVERY_SCHEDULED
  DELIVERY_COMPLETED
  PICKUP_SCHEDULED
  PICKUP_COMPLETED
  DOCUMENT_RECEIVED
  DOCUMENT_VERIFIED
  PAYMENT_RECEIVED
  QUOTE_READY
  QUOTE_EXPIRING
  BOOKING_CONFIRMED
  BOOKING_CHANGED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  INVOICE_GENERATED
  INVOICE_PAID
  INVOICE_OVERDUE
  CREDIT_NOTE_ISSUED
  DEBIT_NOTE_ISSUED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_RESOLVED
  SYSTEM_MAINTENANCE
  SYSTEM_ANNOUNCEMENT
