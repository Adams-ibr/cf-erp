enum ProviderType {
  SMTP
  SENDGRID
  MAILGUN
  SES
  POSTMARK
  TWILIO
  VONAGE
  PLIVO
  FIREBASE
  ONESIGNAL
  PUSHER
  SLACK
  TEAMS
  WHATSAPP_BUSINESS
  VOICE
  FAX
  PRINT
  POSTAL
  CUSTOM
}

enum QueueType {
  EMAIL
  SMS
  PUSH
  IN_APP
  WEBHOOK
  PRIORITY
  BATCH
  SCHEDULED
  RETRY
  DEAD_LETTER
}

enum QueuePriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum BackoffType {
  FIXED
  LINEAR
  EXPONENTIAL
  RANDOM
}

enum MessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  DEAD_LETTER
  CANCELLED
