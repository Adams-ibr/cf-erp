  EMAIL
  SMS
  PUSH
  IN_APP
  WEBHOOK
  SLACK
  TEAMS
  WHATSAPP
  VOICE
  FAX
  PRINT
  POSTAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum RecipientType {
  USER
  ROLE
  GROUP
  DEPARTMENT
  TEAM
  ORGANIZATION
  EMAIL
  PHONE
  DEVICE_TOKEN
  WEBHOOK_URL
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  CLICKED
  FAILED
  BOUNCED
  REJECTED
  EXPIRED
  CANCELLED
  SUPPRESSED
}

enum NotificationEventType {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  CLICKED
  FAILED
  BOUNCED
  REJECTED
  OPENED
  CLICKED
  UNSUBSCRIBED
  COMPLAINT
  RETRY
}

enum EventStatus {
  SUCCESS
  FAILED
  PENDING
  RETRYING
}

enum RecipientType {
  USER
  ROLE
  GROUP
  DEPARTMENT
  TEAM
  ORGANIZATION
  EMAIL
  PHONE
  DEVICE_TOKEN
  WEBHOOK_URL
}

