generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["document", "public"]
}

model Document {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            DocumentType
  category        String?
  status          DocumentStatus   @default(DRAFT)
  mimeType        String
  size            BigInt
  checksum        String
  storageProvider String           @default("local")
  storagePath     String
  storageUrl      String?
  version         Int              @default(1)
  isLatest        Boolean          @default(true)
  previousVersionId String?
  folderId        String?
  templateId      String?
  tags            String[]
  metadata        Json?
  retentionPolicy RetentionPolicy?
  retentionDate   DateTime?
  classification  Classification   @default(INTERNAL)
  accessLevel     AccessLevel      @default(PRIVATE)
  tenantId        String
  branchId        String?
  uploadedBy      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  folder          Folder?          @relation(fields: [folderId], references: [id])
  template        Template?        @relation(fields: [templateId], references: [id])
  previousVersion Document?        @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersion     Document?        @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  versions        DocumentVersion[]
  accessRules     DocumentAccessRule[]
  shares          DocumentShare[]
  ocrResults      OCRResult[]
  classifications DocumentClassification[]

  @@schema("document")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([folderId])
  @@index([templateId])
  @@index([status])
  @@index([type])
  @@index([classification])
  @@index([uploadedBy])
  @@index([createdAt])
  @@index([retentionDate])
}

model DocumentVersion {
  id              String        @id @default(cuid())
  documentId      String
  version         Int
  name            String
  description     String?
  mimeType        String
  size            BigInt
  checksum        String
  storagePath     String
  storageUrl      String?
  changelog       String?
  uploadedBy      String
  createdAt       DateTime      @default(now())

  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@unique([documentId, version])
  @@index([documentId])
  @@index([version])
}

model Folder {
  id              String     @id @default(cuid())
  code            String
  name            String
  description     String?
  parentId        String?
  path            String
  color           String?
  icon            String?
  isSystem        Boolean    @default(false)
  sortOrder       Int        @default(0)
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean    @default(false)

  parent          Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id])
  children        Folder[]   @relation("FolderHierarchy")
  documents       Document[]
  accessRules     FolderAccessRule[]

  @@schema("document")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([parentId])
  @@index([path])
  @@index([isSystem])
}

model Template {
  id              String        @id @default(cuid())
  code            String
  name            String
  description     String?
  type            DocumentType
  category        String?
  content         Json
  fields          TemplateField[]
  isActive        Boolean       @default(true)
  version         Int           @default(1)
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean       @default(false)

  documents       Document[]

  @@schema("document")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([isActive])
}

model TemplateField {
  id              String        @id @default(cuid())
  templateId      String
  name            String
  label           String
  type            FieldType
  required        Boolean       @default(false)
  defaultValue    String?
  options         String[]      @default([])
  validation      Json?
  sortOrder       Int           @default(0)
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  template        Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@index([templateId])
  @@index([sortOrder])
}

model DocumentAccessRule {
  id              String            @id @default(cuid())
  documentId      String
  principalType   AccessPrincipalType
  principalId     String
  permission      AccessPermission
  grantedBy       String
  grantedAt       DateTime          @default(now())
  expiresAt       DateTime?
  conditions      Json?
  tenantId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@unique([documentId, principalType, principalId, permission])
  @@index([documentId])
  @@index([principalType, principalId])
  @@index([permission])
}

model FolderAccessRule {
  id              String            @id @default(cuid())
  folderId        String
  principalType   AccessPrincipalType
  principalId     String
  permission      AccessPermission
  grantedBy       String
  grantedAt       DateTime          @default(now())
  expiresAt       DateTime?
  inherits        Boolean           @default(true)
  conditions      Json?
  tenantId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  folder          Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@unique([folderId, principalType, principalId, permission])
  @@index([folderId])
  @@index([principalType, principalId])
  @@index([permission])
}

model DocumentShare {
  id              String        @id @default(cuid())
  documentId      String
  sharedBy        String
  sharedWith      String
  permission      AccessPermission
  message         String?
  expiresAt       DateTime?
  accessedAt      DateTime?
  accessCount     Int           @default(0)
  token           String        @unique
  isActive        Boolean       @default(true)
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@index([documentId])
  @@index([sharedBy])
  @@index([sharedWith])
  @@index([token])
  @@index([isActive])
  @@index([expiresAt])
}

model OCRResult {
  id              String        @id @default(cuid())
  documentId      String
  engine          String
  language        String
  confidence      Decimal       @db.Decimal(5, 2)
  extractedText   String        @db.Text
  structuredData  Json?
  boundingBoxes   Json?
  processingTime  Int?
  status          OCRStatus     @default(PENDING)
  errorMessage    String?
  tenantId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@index([documentId])
  @@index([engine])
  @@index([status])
}

model DocumentClassification {
  id              String            @id @default(cuid())
  documentId      String
  classifier      String
  classification  Classification
  confidence      Decimal           @db.Decimal(5, 2)
  labels          String[]
  metadata        Json?
  tenantId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  document        Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("document")
  @@index([documentId])
  @@index([classification])
  @@index([classifier])
}

model AuditLog {
  id              String   @id @default(cuid())
  documentId      String?
  folderId        String?
  userId          String
  action          String
  details         Json?
  ipAddress       String?
  userAgent       String?
  tenantId        String
  createdAt       DateTime @default(now())

  @@schema("document")
  @@index([documentId])
  @@index([folderId])
  @@index([userId])
  @@index([action])
  @@index([tenantId])
  @@index([createdAt])
}

enum DocumentType {
  PDF
  WORD
  EXCEL
  POWERPOINT
  IMAGE
  TEXT
  CSV
  XML
  JSON
  ZIP
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  EXPIRED
  DELETED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RetentionPolicy {
  NONE
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
  PERMANENT
  CUSTOM
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  TOP_SECRET
}

enum AccessLevel {
  PUBLIC
  PRIVATE
  TEAM
  DEPARTMENT
  COMPANY
}

enum AccessPrincipalType {
  USER
  ROLE
  GROUP
  DEPARTMENT
  TENANT
}

enum AccessPermission {
  READ
  WRITE
  DELETE
  SHARE
  ADMIN
  VERSION_CONTROL
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  DATETIME
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  FILE
  SIGNATURE
  CURRENCY
  EMAIL
  PHONE
  URL
}

enum OCRStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}