  MAILING
  BILLING
  EMERGENCY
  OTHER
}

enum DocumentType {
  CONTRACT
  OFFER_LETTER
  ID_CARD
  PASSPORT
  VISA
  WORK_PERMIT
  DRIVERS_LICENSE
