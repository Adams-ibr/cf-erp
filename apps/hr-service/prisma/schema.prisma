  MILITARY
  OTHER
}

enum LeaveCategory {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  EMERGENCY
  UNPAID
  STUDY
  COMPASSIONATE
  MARRIAGE
  BEREAVEMENT
  SABBATICAL
  UNPAID_LEAVE
  OTHER
}

enum AccrualFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  PER_PAY_PERIOD
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
  EXPIRED
  PARTIAL
}

enum ReviewType {
  ANNUAL
  PROBATIONARY
  MID_YEAR
  QUARTERLY
  PROJECT_BASED
  PROMOTION
  PERFORMANCE_IMPROVEMENT
  360_DEGREE
  SELF_ASSESSMENT
  PEER_REVIEW
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
  ARCHIVED
}

enum CompensationType {
  BASE_SALARY
  BONUS
  COMMISSION
  OVERTIME
  ALLOWANCE
  REIMBURSEMENT
  STOCK_OPTION
  RSU
  PROFIT_SHARING
  SIGNING_BONUS
  RETENTION_BONUS
  REFERRAL_BONUS
  HAZARD_PAY
  SHIFT_DIFFERENTIAL
  TUITION_REIMBURSEMENT
  CERTIFICATION_BONUS
  OTHER
}

enum PayFrequency {
  WEEKLY
  BI_WEEKLY
  SEMI_MONTHLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum BenefitType {
  HEALTH_INSURANCE
  DENTAL_INSURANCE
  VISION_INSURANCE
  LIFE_INSURANCE
  DISABILITY_INSURANCE
  RETIREMENT_PLAN
  PENSION
  401K
  PENSION_FUND
  STOCK_OPTIONS
  WELLNESS_PROGRAM
  GYM_MEMBERSHIP
  CHILDCARE
  TUITION_ASSISTANCE
  PROFESSIONAL_DEVELOPMENT
  COMMUTER_BENEFITS
  MEAL_ALLOWANCE
  HOUSING_ALLOWANCE
  TRANSPORTATION
  PHONE_ALLOWANCE
  INTERNET_ALLOWANCE
  EQUIPMENT_ALLOWANCE
  RELOCATION
  OTHER
}

enum BenefitStatus {
  ENROLLED
  WAITING
  WAIVED
  TERMINATED
  SUSPENDED
  EXPIRED
  PENDING
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  LOST
  STOLEN
}

enum TrainingCategory {
  TECHNICAL
  SOFT_SKILLS
  LEADERSHIP
  COMPLIANCE
  SAFETY
  SECURITY
  LANGUAGE
  PRODUCT
  PROCESS
  MANAGEMENT
  SALES
  CUSTOMER_SERVICE
  IT_SECURITY
  DATA_PRIVACY
  DIVERSITY_INCLUSION
  WELLNESS
  ONBOARDING
  ORIENTATION
  OTHER
}

enum TrainingType {
  INSTRUCTOR_LED
  E_LEARNING
  BLENDED
  WORKSHOP
  SEMINAR
  WEBINAR
  ON_THE_JOB
  MENTORING
  COACHING
  SIMULATION
  CERTIFICATION
  CONFERENCE
  CONVENTION
  OTHER
}

enum DurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
}

enum GoalType {
  KPI
  OKR
  SMART
  MILESTONE
  BEHAVIORAL
  COMPETENCY
  PROJECT
  LEARNING
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
