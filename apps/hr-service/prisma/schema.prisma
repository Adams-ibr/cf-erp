  NONE
  STANDARD
  DOUBLE_TIME
  TIME_AND_HALF
  COMPENSATORY_TIME
  CUSTOM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
  HALF_DAY
  ON_LEAVE
  REMOTE
  HOLIDAY
  TRAINING
  MEETING
  BUSINESS_TRIP
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  BEREAVEMENT
