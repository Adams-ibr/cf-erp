generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["config", "public"]
}

model Country {
  id              String   @id @default(cuid())
  code            String
  name            String
  isoCode         String
  isoCode3        String?
  numericCode     String?
  region          String
  subRegion       String?
  currency        String
  language        String
  timezone        String
  dialCode        String?
  flagUrl         String?
  capital         String?
  population      BigInt?
  area            Decimal? @db.Decimal(12, 2)
  gdp             Decimal? @db.Decimal(18, 2)
  gdpPerCapita    Decimal? @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  isEU            Boolean  @default(false)
  isOECD          Boolean  @default(false)
  isG20           Boolean  @default(false)
  vatRequired     Boolean  @default(false)
  vatRate         Decimal? @db.Decimal(5, 4)
  customsUnion    Boolean  @default(false)
  freeTradeAgreements String[]
  sanctions       Boolean  @default(false)
  embargo         Boolean  @default(false)
  riskLevel       RiskLevel
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean  @default(false)
  createdBy       String?
  updatedBy       String?

  regulations     Regulation[]
  tradeAgreements TradeAgreementCountry[]
  holidays        Holiday[]
  timeZones       TimeZone[]
  ports           Port[]
  customsCodes    CustomsCode[]

  @@schema("config")
  @@unique([tenantId, code])
  @@unique([tenantId, isoCode])
  @@index([tenantId])
  @@index([isoCode])
  @@index([region])
  @@index([riskLevel])
  @@index([isActive])
  @@index([isEU])
  @@index([isOECD])
  @@index([isG20])
}

model Regulation {
  id              String   @id @default(cuid())
  code            String
  countryId       String
  type            RegulationType
  name            String
  description     String?
  authority       String
  reference       String?
  effectiveDate   DateTime
  expiryDate      DateTime?
  status          RegulationStatus @default(ACTIVE)
  version         String
  documentUrl     String?
  tags            String[] @default([])
  metadata        Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country         Country @relation(fields: [countryId], references: [id])

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryId])
  @@index([type])
  @@index([status])
  @@index([effectiveDate])
  @@index([expiryDate])
}

model TradeAgreement {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            TradeAgreementType
  countries       String[]
  description     String?
  isActive        Boolean  @default(true)
  validFrom       DateTime
  validUntil      DateTime?
  preferentialDuty Decimal? @db.Decimal(5, 4)
  rulesOfOrigin   Json?
  certificateRequired Boolean @default(true)
  metadata        Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  countries       TradeAgreementCountry[]

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model TradeAgreementCountry {
  id              String   @id @default(cuid())
  tradeAgreementId String
  countryId       String
  preferentialRate Decimal? @db.Decimal(5, 4)
  rulesOfOrigin   Json?
  notes           String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tradeAgreement  TradeAgreement @relation(fields: [tradeAgreementId], references: [id], onDelete: Cascade)
  country         Country @relation(fields: [countryId], references: [id])

  @@schema("config")
  @@unique([tradeAgreementId, countryId])
  @@index([tradeAgreementId])
  @@index([countryId])
}

model CustomsCode {
  id              String   @id @default(cuid())
  code            String
  description     String
  chapter         String
  heading         String
  subheading      String?
  unit            String
  dutyRate        Decimal @db.Decimal(5, 4)
  taxRate         Decimal? @db.Decimal(5, 4)
  unitOfMeasure   String
  isActive        Boolean  @default(true)
  validFrom       DateTime
  validUntil      DateTime?
  countryId       String
  parentId        String?
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country         Country @relation(fields: [countryId], references: [id])
  children        CustomsCode[] @relation("CustomsHierarchy", fields: [parentId], references: [id])
  parent          CustomsCode? @relation("CustomsHierarchy", fields: [parentId], references: [id])
  tradeAgreements TradeAgreementTariff[]

  @@schema("config")
  @@unique([tenantId, code, countryId])
  @@index([tenantId])
  @@index([countryId])
  @@index([chapter])
  @@index([heading])
  @@index([subheading])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model TradeAgreementTariff {
  id              String   @id @default(cuid())
  tradeAgreementId String
  customsCodeId   String
  preferentialRate Decimal @db.Decimal(5, 4)
  rulesOfOrigin   Json?
  notes           String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tradeAgreement  TradeAgreement @relation(fields: [tradeAgreementId], references: [id], onDelete: Cascade)
  customsCode     CustomsCode @relation(fields: [customsCodeId], references: [id], onDelete: Cascade)

  @@schema("config")
  @@unique([tradeAgreementId, customsCodeId])
  @@index([tradeAgreementId])
  @@index([customsCodeId])
}

model TaxRate {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            TaxType
  countryId       String
  region          String?
  rate            Decimal @db.Decimal(5, 4)
  effectiveDate   DateTime
  expiryDate      DateTime?
  isActive        Boolean  @default(true)
  appliesTo       String[]
  exemptions      String[] @default([])
  threshold       Decimal? @db.Decimal(18, 2)
  metadata        Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryId])
  @@index([type])
  @@index([isActive])
}

model Holiday {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            HolidayType
  countryId       String
  region          String?
  date            DateTime
  isRecurring     Boolean  @default(true)
  recurrenceRule  String?
  isObserved      Boolean  @default(true)
  isPublicHoliday Boolean  @default(true)
  description     String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country         Country @relation(fields: [countryId], references: [id])

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryId])
  @@index([date])
  @@index([type])
}

model TimeZone {
  id              String   @id @default(cuid())
  code            String
  name            String
  offset          String
  dstOffset       String?
  countryId       String
  region          String?
  isDST           Boolean  @default(false)
  dstStart        String?
  dstEnd          String?
  ianaCode        String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country         Country @relation(fields: [countryId], references: [id])

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryId])
  @@index([code])
}

model Currency {
  id              String   @id @default(cuid())
  code            String
  name            String
  symbol          String
  numericCode     String
  decimalPlaces   Int      @default(2)
  symbolPosition  SymbolPosition @default(PREFIX)
  separator       String   @default(".")
  thousandsSeparator String @default(",")
  isActive        Boolean  @default(true)
  isBase          Boolean  @default(false)
  exchangeRate    Decimal? @db.Decimal(18, 6)
  baseCurrency    String?
  lastUpdated     DateTime?
  source          String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
  @@index([isBase])
}

model ExchangeRate {
  id              String   @id @default(cuid())
  fromCurrency    String
  toCurrency      String
  rate            Decimal @db.Decimal(18, 6)
  date            DateTime
  source          String
  isOfficial      Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([fromCurrency, toCurrency, date])
  @@index([fromCurrency])
  @@index([toCurrency])
  @@index([date])
  @@index([source])
}

model Language {
  id              String   @id @default(cuid())
  code            String
  name            String
  nativeName      String?
  isoCode         String
  isoCode3        String?
  direction       TextDirection @default(LTR)
  isRTL           Boolean  @default(false)
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  locale          String?
  pluralRules     Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
  @@index([isDefault])
}

model Unit {
  id              String   @id @default(cuid())
  code            String
  name            String
  symbol          String
  type            UnitType
  system          UnitSystem
  baseUnit        String?
  conversionFactor Decimal? @db.Decimal(18, 10)
  precision       Int      @default(2)
  isActive        Boolean  @default(true)
  isBase          Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([system])
  @@index([isActive])
  @@index([isBase])
}

model UnitConversion {
  id              String   @id @default(cuid())
  fromUnit        String
  toUnit          String
  factor          Decimal @db.Decimal(18, 10)
  isExact         Boolean  @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([fromUnit, toUnit])
  @@index([fromUnit])
  @@index([toUnit])
}

model Partner {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            PartnerType
  status          PartnerStatus @default(ACTIVE)
  category        String?
  website         String?
  email           String?
  phone           String?
  address         Json?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  taxId           String?
  vatNumber       String?
  registrationNumber String?
  paymentTerms    Int?
  currency        String   @default("USD")
  incoterm        Incoterm?
  rating          Decimal? @db.Decimal(3, 2)
  isPreferred     Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  blockedReason   String?
  contracts       String[] @default([])
  certifications  String[] @default([])
  notes           String?
  metadata        Json?
  tenantId        String
  branchId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean  @default(false)
  createdBy       String?
  updatedBy       String?

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([isPreferred])
  @@index([isBlocked])
}

model Carrier {
  id              String   @id @default(cuid())
  code            String
  name            String
  type            CarrierType
  scac            String?
  mcNumber        String?
  dotNumber       String?
  iataCode        String?
  fmcNumber       String?
  website         String?
  email           String?
  phone           String?
  address         Json?
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  paymentTerms    Int       @default(30)
  currency        String   @default("USD")
  creditLimit     Decimal? @db.Decimal(18, 2)
  rating          Decimal? @db.Decimal(3, 2)
  isPreferred     Boolean  @default(false)
  isActive        Boolean  @default(true)
  contractStart   DateTime?
  contractEnd     DateTime?
  notes           String?
  tenantId        String
  branchId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services        CarrierService[]
  contacts        CarrierContact[]
  documents       CarrierDocument[]

  @@schema("config")
  @@unique([tenantId, code])
  @@unique([tenantId, scac])
  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([isPreferred])
}

model CarrierService {
  id              String   @id @default(cuid())
  carrierId       String
  serviceName     String
  serviceCode     String?
  mode            ShipmentMode
  origin          String?
  destination     String?
  transitTime     Int?
  frequency       String?
  equipment       ContainerType[]
  isActive        Boolean  @default(true)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  carrier         Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@schema("config")
  @@index([carrierId])
  @@index([mode])
  @@index([serviceCode])
}

model Port {
  id              String   @id @default(cuid())
  code            String
  name            String
  unlocode        String?
  countryId       String
  city            String
  region          String?
  type            PortType
  status          PortStatus @default(ACTIVE)
  timezone        String
  coordinates     Json?
  capacity        Int?
  maxDraft        Decimal? @db.Decimal(5, 2)
  maxLoa          Decimal? @db.Decimal(10, 2)
  maxBeam         Decimal? @db.Decimal(10, 2)
  facilities      String[] @default([])
  services        String[] @default([])
  operatingHours  Json?
  contactInfo     Json?
  website         String?
  notes           String?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country         Country @relation(fields: [countryId], references: [id])
  terminals       Terminal[]

  @@schema("config")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryId])
  @@index([unlocode])
  @@index([type])
  @@index([status])
  @@index([city])
}

model Terminal {
  id              String   @id @default(cuid())
  portId          String
  code            String
  name            String
  type            TerminalType
  status          TerminalStatus @default(ACTIVE)
  capacity        Int?
  maxDraft        Decimal? @db.Decimal(5, 2)
  maxLoa          Decimal? @db.Decimal(10, 2)
  maxBeam         Decimal? @db.Decimal(10, 2)
  berths          Int?
  equipment       String[] @default([])
  services        String[] @default([])
  operatingHours  Json?
  contactInfo     Json?
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  port            Port @relation(fields: [portId], references: [id], onDelete: Cascade)

  @@schema("config")
  @@index([portId])
  @@index([code])
  @@index([type])
  @@index([status])
}

model Vessel {
  id              String   @id @default(cuid())
  code            String
  name            String
  imo             String?
  mmsi            String?
  callSign        String?
  flag            String?
  type            VesselType
  capacity        Int?
  dwt             Int?
  loa             Decimal? @db.Decimal(10, 2)
  beam            Decimal? @db.Decimal(10, 2)
  draft           Decimal? @db.Decimal(10, 2)
  yearBuilt       Int?
  builder         String?
  owner           String?
  operator        String?
  isActive        Boolean  @default(true)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("config")
  @@unique([tenantId, code])
  @@unique([tenantId, imo])
  @@index([tenantId])
  @@index([imo])
  @@index([type])
  @@index([isActive])
}

