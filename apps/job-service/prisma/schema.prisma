generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["job", "public"]
}

model Job {
  id              String       @id @default(cuid())
  code            String
  reference       String?
  type            JobType      @default(FREIGHT_FORWARDING)
  status          JobStatus    @default(DRAFT)
  priority        JobPriority  @default(MEDIUM)
  mode            ShipmentMode @default(SEA_FCL)
  direction       ShipmentDirection @default(IMPORT)
  incoterm        Incoterm     @default(FOB)
  currency        String       @default("USD")
  exchangeRate    Decimal      @default(1) @db.Decimal(18, 6)
  customerId      String
  supplierId      String?
  salesRepId      String?
  operationsRepId String?
  origin          String
  destination     String
  commodity       String?
  weight          Decimal?     @db.Decimal(18, 4)
  volume          Decimal?     @db.Decimal(18, 4)
  quantity        Int?
  unit            String?
  value           Decimal?     @db.Decimal(18, 2)
  insuranceValue  Decimal?     @db.Decimal(18, 2)
  pickupDate      DateTime?
  deliveryDate    DateTime?
  cutoffDate      DateTime?
  estimatedDeparture DateTime?
  estimatedArrival  DateTime?
  actualDeparture   DateTime?
  actualArrival     DateTime?
  notes           String?
  internalNotes   String?
  quotationId     String?
  rateCardId      String?
  tenantId        String
  branchId        String?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean      @default(false)

  customer        Customer     @relation(fields: [customerId], references: [id])
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  salesRep        User?        @relation("JobSalesRep", fields: [salesRepId], references: [id])
  operationsRep   User?        @relation("JobOperationsRep", fields: [operationsRepId], references: [id])
  quotation       Quotation?   @relation(fields: [quotationId], references: [id])
  rateCard        RateCard?    @relation(fields: [rateCardId], references: [id])
  shipments       Shipment[]
  legs            JobLeg[]
  milestones      Milestone[]
  documents       Document[]
  tasks           Task[]
  activities      Activity[]
  costs           JobCost[]
  revenues        JobRevenue[]

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([type])
  @@index([mode])
  @@index([salesRepId])
  @@index([operationsRepId])
  @@index([origin, destination])
  @@index([pickupDate])
  @@index([deliveryDate])
  @@index([createdAt])
}

model Shipment {
  id              String           @id @default(cuid())
  code            String
  jobId           String
  masterJobId     String?
  type            ShipmentType     @default(FCL)
  status          ShipmentStatus   @default(DRAFT)
  mode            ShipmentMode     @default(SEA_FCL)
  direction       ShipmentDirection @default(IMPORT)
  incoterm        Incoterm         @default(FOB)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  customerId      String
  supplierId      String?
  carrierId       String?
  bookingId       String?
  containerId     String?
  vesselId        String?
  voyageId        String?
  origin          String
  destination   String
  pol             String?
  pod             String?
  finalDestination String?
  commodity       String?
  weight          Decimal?         @db.Decimal(18, 4)
  volume          Decimal?         @db.Decimal(18, 4)
  quantity        Int?
  unit            String?
  value           Decimal?         @db.Decimal(18, 2)
  insuranceValue  Decimal?         @db.Decimal(18, 2)
  hazardousClass  String?
  unNumber        String?
  imdgClass       String?
  packingGroup    String?
  pickupDate      DateTime?
  deliveryDate    DateTime?
  cutoffDate      DateTime?
  etd             DateTime?
  eta             DateTime?
  atd             DateTime?
  ata             DateTime?
  notes           String?
  internalNotes   String?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  job             Job              @relation(fields: [jobId], references: [id])
  masterJob       Job?             @relation("ShipmentMasterJob", fields: [masterJobId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  carrier         Carrier?         @relation(fields: [carrierId], references: [id])
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  container       Container?       @relation(fields: [containerId], references: [id])
  vessel          Vessel?          @relation(fields: [vesselId], references: [id])
  voyage          Voyage?          @relation(fields: [voyageId], references: [id])
  legs            ShipmentLeg[]
  milestones      Milestone[]
  documents       Document[]
  tasks           Task[]
  activities      Activity[]
  trackingEvents  TrackingEvent[]
  costs           ShipmentCost[]
  revenues        ShipmentRevenue[]
  customsEntries  CustomsEntry[]

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([jobId])
  @@index([masterJobId])
  @@index([customerId])
  @@index([supplierId])
  @@index([carrierId])
  @@index([bookingId])
  @@index([containerId])
  @@index([vesselId])
  @@index([voyageId])
  @@index([status])
  @@index([mode])
  @@index([origin, destination])
  @@index([pol, pod])
  @@index([etd, eta])
  @@index([createdAt])
}

model JobLeg {
  id              String       @id @default(cuid())
  jobId           String
  sequence        Int
  type            LegType
  mode            ShipmentMode
  origin          String
  destination     String
  carrierId       String?
  vesselId        String?
  voyageId        String?
  etd             DateTime?
  eta             DateTime?
  atd             DateTime?
  ata             DateTime?
  status          LegStatus    @default(PENDING)
  notes           String?
  tenantId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  carrier         Carrier?     @relation(fields: [carrierId], references: [id])
  vessel          Vessel?      @relation(fields: [vesselId], references: [id])
  voyage          Voyage?      @relation(fields: [voyageId], references: [id])

  @@schema("job")
  @@unique([jobId, sequence])
  @@index([jobId])
  @@index([carrierId])
  @@index([vesselId])
  @@index([voyageId])
  @@index([status])
}

model ShipmentLeg {
  id              String           @id @default(cuid())
  shipmentId      String
  sequence        Int
  type            LegType
  mode            ShipmentMode
  origin          String
  destination     String
  carrierId       String?
  vesselId        String?
  voyageId        String?
  bookingId       String?
  containerId     String?
  etd             DateTime?
  eta             DateTime?
  atd             DateTime?
  ata             DateTime?
  status          LegStatus        @default(PENDING)
  notes           String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shipment        Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrier         Carrier?         @relation(fields: [carrierId], references: [id])
  vessel          Vessel?          @relation(fields: [vesselId], references: [id])
  voyage          Voyage?          @relation(fields: [voyageId], references: [id])
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  container       Container?       @relation(fields: [containerId], references: [id])

  @@schema("job")
  @@unique([shipmentId, sequence])
  @@index([shipmentId])
  @@index([carrierId])
  @@index([vesselId])
  @@index([voyageId])
  @@index([bookingId])
  @@index([containerId])
  @@index([status])
}

model Milestone {
  id              String           @id @default(cuid())
  code            String
  name            String
  description     String?
  type            MilestoneType
  jobId           String?
  shipmentId      String?
  legId           String?
  plannedDate     DateTime
  actualDate      DateTime?
  status          MilestoneStatus  @default(PENDING)
  completedBy     String?
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  job             Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  shipment        Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg             JobLeg?          @relation("MilestoneJobLeg", fields: [legId], references: [id], onDelete: Cascade)
  shipmentLeg     ShipmentLeg?     @relation("MilestoneShipmentLeg", fields: [legId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([tenantId])
  @@index([jobId])
  @@index([shipmentId])
  @@index([legId])
  @@index([type])
  @@index([status])
  @@index([plannedDate])
  @@index([actualDate])
}

model Customer {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Carrier {
  id        String   @id @default(cuid())
  code      String
  name      String
  type      CarrierType
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model Vessel {
  id        String   @id @default(cuid())
  code      String
  name      String
  imo       String?
  mmsi      String?
  callSign  String?
  flag      String?
  type      VesselType
  capacity  Int?
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([imo])
}

model Voyage {
  id          String   @id @default(cuid())
  code        String
  name        String
  vesselId    String
  serviceCode String?
  etd         DateTime?
  eta         DateTime?
  atd         DateTime?
  ata         DateTime?
  status      VoyageStatus @default(SCHEDULED)
  tenantId    String
  isDeleted   Boolean  @default(false)

  vessel      Vessel   @relation(fields: [vesselId], references: [id])

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([vesselId])
  @@index([status])
}

model Booking {
  id        String   @id @default(cuid())
  code      String
  status    BookingStatus
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
}

model Container {
  id        String   @id @default(cuid())
  code      String
  number    String
  type      ContainerType
  status    ContainerStatus
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([number])
  @@index([type])
  @@index([status])
}

model Document {
  id        String   @id @default(cuid())
  jobId     String?
  shipmentId String?
  type      String
  name      String
  url       String
  tenantId  String
  createdAt DateTime @default(now())

  @@schema("job")
  @@index([jobId])
  @@index([shipmentId])
  @@index([tenantId])
}

model Task {
  id        String   @id @default(cuid())
  jobId     String?
  shipmentId String?
  title     String
  status    TaskStatus
  tenantId  String
  createdAt DateTime @default(now())

  @@schema("job")
  @@index([jobId])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([status])
}

model Activity {
  id        String   @id @default(cuid())
  jobId     String?
  shipmentId String?
  type      String
  subject   String
  tenantId  String
  createdAt DateTime @default(now())

  @@schema("job")
  @@index([jobId])
  @@index([shipmentId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

model JobCost {
  id        String   @id @default(cuid())
  jobId     String
  type      CostType
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("USD")
  tenantId  String
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([jobId])
  @@index([tenantId])
  @@index([type])
}

model JobRevenue {
  id        String   @id @default(cuid())
  jobId     String
  type      RevenueType
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("USD")
  tenantId  String
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([jobId])
  @@index([tenantId])
  @@index([type])
}

model ShipmentCost {
  id          String   @id @default(cuid())
  shipmentId  String
  type        CostType
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD")
  tenantId    String
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([shipmentId])
  @@index([tenantId])
  @@index([type])
}

model ShipmentRevenue {
  id          String   @id @default(cuid())
  shipmentId  String
  type        RevenueType
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD")
  tenantId    String
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([shipmentId])
  @@index([tenantId])
  @@index([type])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  type        TrackingEventType
  location    String
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  timestamp   DateTime
  status      String
  details     String?
  source      String
  tenantId    String
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([shipmentId])
  @@index([tenantId])
  @@index([type])
  @@index([timestamp])
}

model CustomsEntry {
  id          String   @id @default(cuid())
  shipmentId  String
  type        CustomsEntryType
  status      CustomsStatus
  reference   String?
  tenantId    String
  createdAt   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@schema("job")
  @@index([shipmentId])
  @@index([tenantId])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  email     String
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("job")
  @@unique([tenantId, email])
}

model Quotation {
  id        String   @id @default(cuid())
  code      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model RateCard {
  id        String   @id @default(cuid())
  code      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("job")
  @@unique([tenantId, code])
  @@index([tenantId])
}

enum JobType {
  FREIGHT_FORWARDING
  CUSTOMS_BROKERAGE
  WAREHOUSING
  TRANSPORT
  CONSOLIDATION
  DECONSOLIDATION
  PROJECT_CARGO
  COURIER
  OTHER
}

enum JobStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTED
  BOOKED
  CONFIRMED
  DOCUMENTS_PENDING
  DOCUMENTS_RECEIVED
  CUSTOMS_PENDING
  CUSTOMS_CLEARED
  CUSTOMS_HOLD
  CUSTOMS_EXAM
  LOADED
  IN_TRANSIT
  ARRIVED
  UNLOADED
  DELIVERED
  COMPLETED
  CANCELLED
  ON_HOLD
  PROBLEM
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum ShipmentMode {
  SEA_FCL
  SEA_LCL
  AIR
  ROAD
  RAIL
  MULTIMODAL
  COURIER
}

enum ShipmentDirection {
  IMPORT
  EXPORT
  TRANSIT
  CROSS_TRADE
  DOMESTIC
}

enum ShipmentType {
  FCL
  LCL
  AIR
  ROAD
  RAIL
  MULTIMODAL
  COURIER
  BREAKBULK
  RO_RO
  PROJECT
}

enum ShipmentStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTED
  BOOKED
  CONFIRMED
  DOCUMENTS_PENDING
  DOCUMENTS_RECEIVED
  CUSTOMS_PENDING
  CUSTOMS_CLEARED
  CUSTOMS_HOLD
  CUSTOMS_EXAM
  LOADED
  IN_TRANSIT
  ARRIVED
  UNLOADED
  DELIVERED
  COMPLETED
  CANCELLED
  ON_HOLD
  PROBLEM
}

enum LegType {
  PRE_CARRIAGE
  MAIN_CARRIAGE
  ON_CARRIAGE
  INLAND
  FEEDER
  TRANSSHIPMENT
}

enum LegStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
  SKIPPED
}

enum MilestoneType {
  BOOKING_CONFIRMED
  DOCUMENTS_RECEIVED
  CUSTOMS_FILED
  CUSTOMS_CLEARED
  CARGO_RECEIVED
  LOADED_ON_VESSEL
  VESSEL_DEPARTED
  VESSEL_ARRIVED
  CARGO_DISCHARGED
  CUSTOMS_RELEASED
  DELIVERED
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  SKIPPED
  CANCELLED
}

enum CarrierType {
  SHIPPING_LINE
  AIRLINE
  TRUCKING
  RAIL
  NVOCC
  FREIGHT_FORWARDER
  COURIER
  MULTIMODAL
}

enum VesselType {
  CONTAINER
  BULK
  TANKER
  RO_RO
  GENERAL_CARGO
  REEFER
  LNG
  LPG
  OTHER
}

enum VoyageStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  QUOTED
  CONFIRMED
  BOOKED
  CANCELLED
  AMENDED
  SPLIT
  ROLLED
}

enum ContainerType {
  DRY_20FT
  DRY_40FT
  DRY_40FT_HC
  DRY_45FT_HC
  REEFER_20FT
  REEFER_40FT
  REEFER_40FT_HC
  OPEN_TOP_20FT
  OPEN_TOP_40FT
  FLAT_RACK_20FT
  FLAT_RACK_40FT
  TANK_20FT
  TANK_40FT
  SPECIAL
}

enum ContainerStatus {
  AVAILABLE
  BOOKED
  PICKED_UP
  IN_YARD
  LOADED
  ON_VESSEL
  IN_TRANSIT
  ARRIVED
  UNLOADED
  DELIVERED
  EMPTY_RETURN
  DAMAGED
  MAINTENANCE
  SOLD
  SCRAPPED
}

enum CostType {
  FREIGHT
  ORIGIN_CHARGES
  DESTINATION_CHARGES
  CUSTOMS_DUTY
  TAXES
  INSURANCE
  HANDLING
  STORAGE
  DEMURRAGE
  DETENTION
  DOCUMENTATION
  OTHER
}

enum RevenueType {
  FREIGHT
  ORIGIN_CHARGES
  DESTINATION_CHARGES
  CUSTOMS_CLEARANCE
  DOCUMENTATION
  INSURANCE
  HANDLING
  STORAGE
  VALUE_ADDED
  OTHER
}

enum TrackingEventType {
  BOOKING_CONFIRMED
  EQUIPMENT_ASSIGNED
  PICKUP_SCHEDULED
  PICKUP_COMPLETED
  GATE_IN
  LOADED_ON_VESSEL
  VESSEL_DEPARTED
  IN_TRANSIT
  VESSEL_ARRIVED
  DISCHARGED
  GATE_OUT
  DELIVERY_SCHEDULED
  DELIVERY_COMPLETED
  CUSTOMS_FILED
  CUSTOMS_CLEARED
  CUSTOMS_HOLD
  CUSTOMS_EXAM
  EXCEPTION
  DELAY
  DAMAGE
  TEMPERATURE_ALERT
}

enum CustomsEntryType {
  IMPORT_DECLARATION
  EXPORT_DECLARATION
  TRANSIT_DECLARATION
  TEMPORARY_IMPORT
  BONDED_WAREHOUSE
  RE_EXPORT
}

enum CustomsStatus {
  NOT_STARTED
  DOCUMENTS_PREPARING
  DOCUMENTS_SUBMITTED
  UNDER_REVIEW
  QUERY_RAISED
  QUERY_RESPONDED
  EXAMINATION_SCHEDULED
  EXAMINATION_COMPLETED
  ASSESSMENT_COMPLETED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  CLEARED
  RELEASED
  HOLD
  SEIZED
  REJECTED
}

enum Incoterm {
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  OVERDUE
}