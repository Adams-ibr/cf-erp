}

enum DutyStatus {
  CALCULATING
  CALCULATED
  VERIFIED
  PAID
  PARTIAL_PAID
  OVERDUE
  DISPUTED
  WAIVED
  EXEMPT
  CANCELLED
  EXPIRED
}

