generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["arap", "public"]
}

model ARInvoice {
  id              String           @id @default(cuid())
  code            String
  invoiceId       String?
  customerId      String
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  totalAmount     Decimal          @db.Decimal(18, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal          @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal          @db.Decimal(18, 2)
  dueDate         DateTime
  issueDate       DateTime
  status          ARInvoiceStatus  @default(OPEN)
  paymentTerms    Int              @default(30)
  discountTerms   String?
  discountDate    DateTime?
  discountAmount  Decimal          @default(0) @db.Decimal(18, 2)
  salesRepId      String?
  collectorId     String?
  collectionNotes String?
  lastPaymentDate DateTime?
  lastActivityDate DateTime?
  disputeStatus   DisputeStatus    @default(NONE)
  disputeAmount   Decimal          @default(0) @db.Decimal(18, 2)
  notes           String?
  internalNotes   String?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  createdBy       String?
  updatedBy       String?

  payments        ARPayment[]
  creditMemos     ARCreditMemo[]
  activities      ARActivity[]
  disputes        ARDispute[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
  @@index([salesRepId])
  @@index([collectorId])
}

model ARPayment {
  id              String           @id @default(cuid())
  code            String
  invoiceId       String
  customerId      String
  type            ARPaymentType
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  reference       String?
  transactionId   String?
  paymentDate     DateTime
  postedDate      DateTime?
  bankReference   String?
  batchId         String?
  depositDate     DateTime?
  fees            Decimal          @default(0) @db.Decimal(18, 2)
  netAmount       Decimal          @db.Decimal(18, 2)
  appliedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  unappliedAmount Decimal          @default(0) @db.Decimal(18, 2)
  notes           String?
  metadata        Json?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  invoice         ARInvoice        @relation(fields: [invoiceId], references: [id])
  applications    PaymentApplication[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paymentDate])
  @@index([postedDate])
  @@index([batchId])
}

model PaymentApplication {
  id              String           @id @default(cuid())
  paymentId       String
  invoiceId       String
  appliedAmount   Decimal          @db.Decimal(18, 2)
  appliedDate     DateTime
  appliedBy       String
  notes           String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payment         ARPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice         ARInvoice        @relation(fields: [invoiceId], references: [id])

  @@schema("arap")
  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
}

model ARCreditMemo {
  id              String           @id @default(cuid())
  code            String
  invoiceId       String?
  customerId      String
  type            CreditMemoType
  status          CreditMemoStatus @default(DRAFT)
  reason          String
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  appliedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal          @db.Decimal(18, 2)
  issueDate       DateTime
  appliedDate     DateTime?
  voidedDate      DateTime?
  voidReason      String?
  notes           String?
  internalNotes   String?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  applications    CreditMemoApplication[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model CreditMemoApplication {
  id              String           @id @default(cuid())
  creditMemoId    String
  invoiceId       String
  appliedAmount   Decimal          @db.Decimal(18, 2)
  appliedDate     DateTime
  appliedBy       String
  notes           String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  creditMemo      ARCreditMemo     @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  invoice         ARInvoice        @relation(fields: [invoiceId], references: [id])

  @@schema("arap")
  @@unique([creditMemoId, invoiceId])
  @@index([creditMemoId])
  @@index([invoiceId])
}

model ARActivity {
  id              String           @id @default(cuid())
  invoiceId       String
  type            ARActivityType
  description     String
  userId          String
  amount          Decimal?         @db.Decimal(18, 2)
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())

  invoice         ARInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@schema("arap")
  @@index([invoiceId])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model ARDispute {
  id              String           @id @default(cuid())
  invoiceId       String
  code            String
  type            DisputeType
  status          DisputeStatus    @default(OPEN)
  reason          String
  claimedAmount   Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  openedBy        String
  assignedTo      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolution      DisputeResolution?
  resolutionAmount Decimal?        @db.Decimal(18, 2)
  evidence        String[]         @default([])
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice         ARInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
}

model APBill {
  id              String           @id @default(cuid())
  code            String
  billId          String?
  vendorId        String
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  totalAmount     Decimal          @db.Decimal(18, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(18, 2)
  creditAmount    Decimal          @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal          @db.Decimal(18, 2)
  dueDate         DateTime
  issueDate       DateTime
  receiptDate     DateTime?
  status          APBillStatus     @default(OPEN)
  paymentTerms    Int              @default(30)
  discountTerms   String?
  discountDate    DateTime?
  discountAmount  Decimal          @default(0) @db.Decimal(18, 2)
  buyerId         String?
  approverId      String?
  approvalDate    DateTime?
  approvedBy      String?
  notes           String?
  internalNotes   String?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)
  createdBy       String?
  updatedBy       String?

  payments        APPayment[]
  creditMemos     APCreditMemo[]
  activities      APActivity[]
  disputes        APDispute[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
  @@index([receiptDate])
  @@index([buyerId])
  @@index([approverId])
}

model APPayment {
  id              String           @id @default(cuid())
  code            String
  billId          String
  vendorId        String
  type            APPaymentType
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  reference       String?
  transactionId   String?
  paymentDate     DateTime
  postedDate      DateTime?
  bankReference   String?
  batchId         String?
  checkNumber     String?
  checkDate       DateTime?
  fees            Decimal          @default(0) @db.Decimal(18, 2)
  netAmount       Decimal          @db.Decimal(18, 2)
  appliedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  unappliedAmount Decimal          @default(0) @db.Decimal(18, 2)
  notes           String?
  metadata        Json?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  bill            APBill           @relation(fields: [billId], references: [id])
  applications    APPaymentApplication[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([billId])
  @@index([vendorId])
  @@index([status])
  @@index([paymentDate])
  @@index([postedDate])
  @@index([batchId])
}

model APPaymentApplication {
  id              String           @id @default(cuid())
  paymentId       String
  billId          String
  appliedAmount   Decimal          @db.Decimal(18, 2)
  appliedDate     DateTime
  appliedBy       String
  notes           String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payment         APPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill            APBill           @relation(fields: [billId], references: [id])

  @@schema("arap")
  @@unique([paymentId, billId])
  @@index([paymentId])
  @@index([billId])
}

model APCreditMemo {
  id              String           @id @default(cuid())
  code            String
  billId          String?
  vendorId        String
  type            APCreditMemoType
  status          CreditMemoStatus @default(DRAFT)
  reason          String
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  exchangeRate    Decimal          @default(1) @db.Decimal(18, 6)
  appliedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal          @db.Decimal(18, 2)
  issueDate       DateTime
  appliedDate     DateTime?
  voidedDate      DateTime?
  voidReason      String?
  notes           String?
  internalNotes   String?
  tenantId        String
  branchId        String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  applications    APCreditMemoApplication[]

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([billId])
  @@index([vendorId])
  @@index([status])
  @@index([issueDate])
}

model APCreditMemoApplication {
  id              String           @id @default(cuid())
  creditMemoId    String
  billId          String
  appliedAmount   Decimal          @db.Decimal(18, 2)
  appliedDate     DateTime
  appliedBy       String
  notes           String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  creditMemo      APCreditMemo     @relation(fields: [creditMemoId], references: [id], onDelete: Cascade)
  bill            APBill           @relation(fields: [billId], references: [id])

  @@schema("arap")
  @@unique([creditMemoId, billId])
  @@index([creditMemoId])
  @@index([billId])
}

model APActivity {
  id              String           @id @default(cuid())
  billId          String
  type            APActivityType
  description     String
  userId          String
  amount          Decimal?         @db.Decimal(18, 2)
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())

  bill            APBill           @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@schema("arap")
  @@index([billId])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model APDispute {
  id              String           @id @default(cuid())
  billId          String
  code            String
  type            DisputeType
  status          DisputeStatus    @default(OPEN)
  reason          String
  claimedAmount   Decimal          @db.Decimal(18, 2)
  currency        String           @default("USD")
  openedBy        String
  assignedTo      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolution      DisputeResolution?
  resolutionAmount Decimal?        @db.Decimal(18, 2)
  evidence        String[]         @default([])
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bill            APBill           @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([billId])
  @@index([status])
