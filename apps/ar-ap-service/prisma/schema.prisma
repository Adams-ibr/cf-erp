  @@index([assignedTo])
}

model AgingReport {
  id              String           @id @default(cuid())
  code            String
  type            AgingType
  asOfDate        DateTime
  currency        String           @default("USD")
  current         Decimal          @default(0) @db.Decimal(18, 2)
  days1to30       Decimal          @default(0) @db.Decimal(18, 2)
  days31to60      Decimal          @default(0) @db.Decimal(18, 2)
  days61to90      Decimal          @default(0) @db.Decimal(18, 2)
  days91to120     Decimal          @default(0) @db.Decimal(18, 2)
  daysOver120     Decimal          @default(0) @db.Decimal(18, 2)
  totalOutstanding Decimal         @db.Decimal(18, 2)
  tenantId        String
  branchId        String?
  generatedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([asOfDate])
}

model CollectionAction {
  id              String           @id @default(cuid())
  invoiceId       String
  customerId      String
  type            CollectionActionType
  status          CollectionActionStatus @default(PLANNED)
  priority        Priority
  scheduledAt     DateTime
  completedAt     DateTime?
  assignedTo      String
  completedBy     String?
  result          CollectionResult?
  nextActionDate  DateTime?
  notes           String?
  metadata        Json?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([scheduledAt])
}

model PaymentBatch {
  id              String           @id @default(cuid())
  code            String
  type            BatchType
  status          BatchStatus      @default(OPEN)
  totalAmount     Decimal          @default(0) @db.Decimal(18, 2)
  paymentCount    Int              @default(0)
  currency        String           @default("USD")
  bankAccountId   String?
  depositDate     DateTime?
  createdBy       String
  postedBy        String?
  postedAt        DateTime?
  closedBy        String?
  closedAt        DateTime?
  notes           String?
  tenantId        String
  branchId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean          @default(false)

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([depositDate])
}

model Customer {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Vendor {
  id        String   @id @default(cuid())
  code      String
  name      String
  tenantId  String
  isDeleted Boolean  @default(false)

  @@schema("arap")
  @@unique([tenantId, code])
  @@index([tenantId])
}

