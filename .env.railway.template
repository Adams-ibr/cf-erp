# =============================================================================
# RAILWAY ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.railway and fill in your values
# Then set these in Railway dashboard: Project → Variables → Add Variable
# Or use CLI: railway variables set KEY=VALUE --service <service-name>
# =============================================================================

# =============================================================================
# GLOBAL VARIABLES (Set at Project level in Railway Dashboard)
# These are automatically injected by Railway when you link databases
# =============================================================================

# DATABASE_URL=postgresql://user:pass@host:port/db?schema=public
# REDIS_URL=redis://user:pass@host:port
# RABBITMQ_URL=amqp://user:pass@host:port
# KAFKA_BROKERS=host1:9092,host2:9092

# =============================================================================
# JWT & AUTH (Set at Project level - shared across all services)
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-different-from-jwt-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cf-erp
JWT_AUDIENCE=cf-erp-api

# =============================================================================
# APP CONFIGURATION (Per service - set in each service's variables)
# =============================================================================
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# CORS
CORS_ORIGIN=https://your-frontend-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=CF-ERP API
SWAGGER_DESCRIPTION=Clearing & Forwarding ERP API Documentation
SWAGGER_VERSION=1.0.0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs

# Monitoring
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Feature Flags
FF_CUSTOMER_PORTAL=false
FF_MOBILE_APP=false
FF_AI_ASSISTANT=false
FF_ADVANCED_ANALYTICS=false
FF_BLOCKCHAIN_TRACKING=false

# =============================================================================
# DATABASE (Auto-injected by Railway when you link PostgreSQL)
# =============================================================================
# DATABASE_URL=postgresql://user:pass@host:port/db?schema=public

# =============================================================================
# REDIS (Auto-injected by Railway when you link Redis)
# =============================================================================
# REDIS_URL=redis://user:pass@host:port

# =============================================================================
# RABBITMQ (Add manually if using external RabbitMQ)
# =============================================================================
# RABBITMQ_URL=amqp://user:pass@host:port/vhost
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/

# =============================================================================
# KAFKA (Add manually if using external Kafka)
# =============================================================================
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=cf-erp
# KAFKA_GROUP_ID=cf-erp-group
# KAFKA_SSL=false
# KAFKA_SASL=false

# =============================================================================
# EMAIL (Configure for your provider)
# =============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=CF-ERP
EMAIL_TEMPLATES_DIR=./templates/email

# =============================================================================
# SMS (Configure for your provider)
# =============================================================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# PUSH NOTIFICATIONS (Configure for your provider)
# =============================================================================
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# =============================================================================
# FILE STORAGE (Configure for your provider)
# =============================================================================
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AWS S3 (if using S3)
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_ENDPOINT=
# AWS_S3_CDN_URL=

# =============================================================================
# MINIO (Alternative to S3)
# =============================================================================
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=cf-erp
# MINIO_USE_SSL=false

# =============================================================================
# SENTRY (Error tracking)
# =============================================================================
SENTRY_DSN=https://your-dsn@sentry.io/project
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# DATADOG (APM)
# =============================================================================
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com

# =============================================================================
# SWAGGER
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=CF-ERP API
SWAGGER_DESCRIPTION=Clearing & Forwarding ERP API Documentation
SWAGGER_VERSION=1.0.0

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FF_CUSTOMER_PORTAL=false
FF_MOBILE_APP=false
FF_AI_ASSISTANT=false
FF_ADVANCED_ANALYTICS=false
FF_BLOCKCHAIN_TRACKING=false

# =============================================================================
# INTEGRATIONS (Configure per service as needed)
# =============================================================================
CUSTOMS_INTEGRATION_ENABLED=false
CUSTOMS_API_URL=
CUSTOMS_API_KEY=

SHIPPING_LINES_INTEGRATION_ENABLED=false
SHIPPING_LINES_API_URL=
SHIPPING_LINES_API_KEY=

PORTS_INTEGRATION_ENABLED=false
PORTS_API_URL=
PORTS_API_KEY=

BANKS_INTEGRATION_ENABLED=false
BANKS_API_URL=
BANKS_API_KEY=

ERP_INTEGRATION_ENABLED=false
ERP_API_URL=
ERP_API_KEY=

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=https://your-frontend-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=86400

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# =============================================================================
# SWAGGER
# =============================================================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=CF-ERP API
SWAGGER_DESCRIPTION=Clearing & Forwarding ERP API Documentation
SWAGGER_VERSION=1.0.0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# =============================================================================
# MONITORING
# =============================================================================
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

